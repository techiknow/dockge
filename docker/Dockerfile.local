############################################
# Local / from-source production image
# Builds frontend + backend without relying on
# pre-published louislam/dockge base tags.
############################################

############################################
# Base (Node + Docker CLI + Compose plugin)
############################################
FROM node:22-bookworm-slim AS base
RUN apt-get update && apt-get install --yes --no-install-recommends \
    curl \
    ca-certificates \
    gnupg \
    unzip \
    dumb-init \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo \
         "deb [arch="$(dpkg --print-architecture)" signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian \
         "$(. /etc/os-release && echo "$VERSION_CODENAME")" stable" | \
         tee /etc/apt/sources.list.d/docker.list > /dev/null \
    && apt-get update \
    && apt-get --yes --no-install-recommends install \
         docker-ce-cli \
         docker-compose-plugin \
         docker-buildx-plugin \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g tsx

############################################
# Healthcheck binary
############################################
FROM golang:1.21.4-bookworm AS healthcheck
WORKDIR /app
COPY ./extra/healthcheck.go ./extra/healthcheck.go
RUN go build -o ./extra/healthcheck ./extra/healthcheck.go

############################################
# Frontend build
############################################
FROM node:22-bookworm-slim AS frontend
WORKDIR /app
COPY package.json package-lock.json ./
COPY frontend ./frontend
COPY common ./common
RUN npm ci
RUN npm run build:frontend

############################################
# Production node_modules
############################################
FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

############################################
# Release
############################################
FROM base AS release
WORKDIR /app
COPY --chown=node:node --from=healthcheck /app/extra/healthcheck /app/extra/healthcheck
COPY --from=deps /app/node_modules /app/node_modules
COPY --chown=node:node --from=frontend /app/frontend-dist /app/frontend-dist
COPY --chown=node:node package.json package-lock.json tsconfig.json ./
COPY --chown=node:node backend ./backend
COPY --chown=node:node common ./common
COPY --chown=node:node extra ./extra
RUN mkdir ./data

ENV UV_USE_IO_URING=0
ENV DOCKGE_IS_CONTAINER=1

VOLUME /app/data
EXPOSE 5001
HEALTHCHECK --interval=60s --timeout=30s --start-period=60s --retries=5 CMD extra/healthcheck
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["tsx", "./backend/index.ts"]
