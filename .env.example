# Copy to .env and adjust as needed:
#   cp .env.example .env
#
# Used by: npm run dev (via dotenv), Vite, and compose.yaml

# Backend HTTP / Socket.IO port (inside process and container)
DOCKGE_PORT=5001

# Host port published by Docker Compose (host:container → DOCKGE_HOST_PORT:DOCKGE_PORT)
DOCKGE_HOST_PORT=5001

# NetBird IP or 127.0.0.1 to restrict access to VPN overlay / localhost
NETBIRD_IP=127.0.0.1

# Vite frontend dev server port (npm run dev only)
# Use something other than 5000 on macOS (AirPlay Receiver binds 5000)
DOCKGE_FRONTEND_PORT=5002

# App data (SQLite, etc.) — relative to repo root
DOCKGE_DATA_DIR=./data

# Compose stacks directory (absolute path; host === container)
DOCKGE_STACKS_DIR=/opt/stacks

# Docker image tag for compose.yaml
DOCKGE_IMAGE=dockge:local

# Host SSH directory mounted into container for Git operations
# DOCKGE_SSH_DIR=~/.ssh

# optional (dangerous)
# DOCKGE_ENABLE_CONSOLE=true
